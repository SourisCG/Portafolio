---
import { type Project, type Locale, type Translation } from "../i18n";

export interface Props {
  project: Project;
  locale: Locale;
  t: Translation;
  compact?: boolean;
}

const { project, locale, t, compact = false } = Astro.props as Props;
const data = project.i18n[locale];
const statusLabel = t.projects.status[project.status];
const linkLabel =
  project.links.find((l) => l.label === "repo")?.url ? t.projects.view_repo : null;
const releaseUrl = project.links.find((l) => l.label === "release")?.url;
const demoUrl = project.links.find((l) => l.label === "demo")?.url;
---

<article class:list={["project-card", "pixel-card", compact && "is-compact"]}>
  <header class="card-header">
    <h3 class="card-title">
      <a href={`/${locale}/projects/${project.slug}/`}>{project.name}</a>
    </h3>
    <span class:list={["status-badge", `status-${project.status}`]}>{statusLabel}</span>
  </header>

  <p class="card-tagline">{data.tagline}</p>

  {!compact && <p class="card-desc">{data.description}</p>}

  <div class="card-tags">
    {project.tags.map((tag) => (
      <span class:list={["tag", tag]}>{tag}</span>
    ))}
    {project.language.map((lang) => (
      <span class="tag" data-lang>{lang}</span>
    ))}
  </div>

  <div class="card-links">
    <a class="btn btn-secondary" href={`/${locale}/projects/${project.slug}/`}>{t.projects.detail.stack}</a>
    {linkLabel && (
      <a class="btn btn-secondary" href={project.repo} rel="noopener" target="_blank">
        {t.projects.view_repo}
      </a>
    )}
    {releaseUrl && (
      <a class="btn btn-secondary" href={releaseUrl} rel="noopener" target="_blank">
        {t.projects.view_release}
      </a>
    )}
    {demoUrl && (
      <a class="btn btn-secondary" href={demoUrl} rel="noopener" target="_blank">
        {t.projects.view_demo}
      </a>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .card-title {
    font-size: 0.95rem;
    margin: 0;
  }

  .card-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .card-title a:hover,
  .card-title a:focus-visible {
    background-color: var(--ink);
    color: var(--bg);
  }

  .card-tagline {
    font-family: var(--font-display);
    font-size: 0.75rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .card-desc {
    font-size: 0.95rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .card-tags .tag[data-lang] {
    background-color: var(--bg-paper);
    color: var(--ink-soft);
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .is-compact .card-desc {
    display: none;
  }
</style>
