---
import { localizedPath } from "../i18n/utils";
import { localeShort, type Locale, type Translation } from "../i18n";

export interface Props {
  locale: Locale;
  t: Translation;
  pathname: string;
}

const { locale, t, pathname } = Astro.props as Props;
const otherLocale: Locale = locale === "en" ? "es" : "en";
const stripLeadingLocale = (p: string) => p.replace(/^\/(en|es)(\/|$)/, "/");
const cleanPath = stripLeadingLocale(pathname || "/");
const buildHref = (loc: Locale) => localizedPath(loc, cleanPath);

const navItems = [
  { href: `/${locale}/`, label: t.nav.home },
  { href: `/${locale}/about/`, label: t.nav.about },
  { href: `/${locale}/projects/`, label: t.nav.projects },
  { href: `/${locale}/now/`, label: t.nav.now },
  { href: `/${locale}/links/`, label: t.nav.links },
];
---

<header class="site-header">
  <div class="container">
    <a class="brand" href={`/${locale}/`}>
      <span class="brand-mark">S</span>
      <span class="brand-text">SourisCG</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <div class="lang-switch" aria-label="Language">
      <a
        class:list={["lang-pill", locale === "en" && "is-active"]}
        href={buildHref("en")}
        aria-current={locale === "en" ? "true" : undefined}
      >{localeShort.en}</a>
      <span class="lang-sep">/</span>
      <a
        class:list={["lang-pill", locale === "es" && "is-active"]}
        href={buildHref("es")}
        aria-current={locale === "es" ? "true" : undefined}
      >{localeShort.es}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--border-w) solid var(--border);
    background-color: var(--bg-paper);
    box-shadow: 0 var(--shadow-offset) 0 var(--shadow);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.85rem;
  }

  .brand:hover,
  .brand:focus-visible {
    background-color: transparent;
    color: var(--accent);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background-color: var(--accent);
    color: var(--bg);
    border: var(--border-w) solid var(--border);
    box-shadow: 2px 2px 0 var(--shadow);
    font-family: var(--font-display);
  }

  .site-nav {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    flex: 1;
  }

  .site-nav a {
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--ink);
    padding: 4px 6px;
    border-bottom: 2px solid transparent;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    background-color: var(--ink);
    color: var(--bg);
    border-bottom-color: var(--accent);
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: 0.7rem;
  }

  .lang-pill {
    display: inline-block;
    border: var(--border-w) solid var(--border);
    padding: 4px 8px;
    text-decoration: none;
    color: var(--ink);
    background-color: var(--bg-card);
  }

  .lang-pill.is-active {
    background-color: var(--ink);
    color: var(--bg);
  }

  .lang-pill:hover,
  .lang-pill:focus-visible {
    background-color: var(--accent);
    color: var(--bg);
  }

  .lang-sep {
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .container {
      padding: 12px 14px;
    }
    .site-nav {
      order: 3;
      width: 100%;
      gap: 8px;
    }
    .site-nav a {
      font-size: 0.85rem;
    }
  }
</style>
