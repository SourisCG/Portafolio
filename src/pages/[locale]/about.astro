---
import Base from "../../layouts/Base.astro";
import { translations, type Locale } from "../../i18n";

export function getStaticPaths() {
  return [
    { params: { locale: "en" } },
    { params: { locale: "es" } },
  ];
}

const { locale } = Astro.params as { locale: Locale };
const t = translations[locale];
---

<Base
  locale={locale}
  title={`${t.nav.about} — ${t.site.title}`}
  pathname={Astro.url.pathname}
>
  <section class="about pixel-card">
    <h1>{t.about.title}</h1>
    <p class="about-lead">{t.about.body}</p>

    <h2>{t.about.interests_title}</h2>
    <ul>
      {t.about.interests.map((item) => (
        <li>{item}</li>
      ))}
    </ul>

    <h2>{t.about.focus_title}</h2>
    <ul>
      {t.about.focus.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .about {
    margin-top: 12px;
  }

  .about-lead {
    font-size: 1.05rem;
    color: var(--ink-soft);
    margin-bottom: 18px;
  }
</style>
